---
/**
 * A link to another origin: it opens in a new tab (static target and rel, no script), says so
 * to assistive tech with a visually hidden text, and shows a small arrow after the text.
 * Same-site links stay plain <a>.
 */
interface Props {
  href: string;
  /** The small ↗ after the text (default true) */
  arrow?: boolean;
}

const { href, arrow = true } = Astro.props;
---

<a href={href} target="_blank" rel="noopener"><slot />{arrow && <span class="ext-arrow" aria-hidden="true">↗</span>}<span class="sr-only"> (opens in a new tab)</span></a>

<style>
  a {
    color: var(--ink);
    text-underline-offset: 3px;
  }

  .ext-arrow {
    display: inline-block;
    margin-left: 0.2em;
    color: var(--muted);
    font-size: 0.8em;
    text-decoration: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
