---
/**
 * The guides page of a kit (/harbuz, /kavun, /dynia): what the kit is, a prominent link to the kit's own site, a plain
 * note that the package is private and not installable yet, and the list of the kit's live guides (src/content/<kit>/).
 * Production lists the live guides only; dev and previews also list the drafts with their date.
 *
 * It does not take the kit home's search ("react ui kit" and the like belong to the kit's own site): the title, h1 and
 * description in src/data/kits.ts name the kit and its guides.
 *
 * Same look as the guides themselves (src/components/KitArticle.astro): the article page of /papyrus/<slug> on a plain sheet.
 */
import Layout from '../layouts/Layout.astro';
import '../styles/article.css';
import '../styles/kit-guides.css';
import { articlePath, dateText, getArticles, isLive, kindLabel, sections, type Entry } from '../data/articles';
import { externalAttrs, newTabNote } from '../data/links';
import { inlineCodeHtml, plainText } from '../data/inline-code.mjs';
import { kitList, kits, type Kit, type KitId } from '../data/kits';
import { studioId } from '../data/projects';
import { absolute, breadcrumbList } from '../data/schema';

interface Props {
  kit: KitId;
}

const kit: Kit = kits[Astro.props.kit];
const section = sections[kit.id];
const articles: Entry[] = await getArticles(kit.id);
const siteHost: string = new URL(kit.siteUrl).host;
const others: readonly Kit[] = kitList.filter((other: Kit): boolean => other.id !== kit.id);

// The kit's own node, which every guide of the kit is "about". Its url is the kit's site; the repository is private, so it
// has no codeRepository. The Organization node comes from the layout.
const software: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  '@id': section.softwareId,
  name: kit.name,
  description: plainText(kit.about[0]),
  url: kit.siteUrl,
  programmingLanguage: 'TypeScript',
  author: { '@id': studioId },
  publisher: { '@id': studioId },
};

const guideList: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: kit.h1,
  itemListElement: articles.map((entry: Entry, index: number) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: plainText(entry.data.h1),
    url: absolute(articlePath(kit.id, entry.id)),
  })),
};
---

<Layout
  title={kit.title}
  description={kit.description}
  path={kit.path}
  image={`/og/${kit.id}.png`}
  imageAlt={kit.h1}
  structuredData={[software, breadcrumbList([{ name: 'n-uf', path: '/' }, { name: kit.name, path: kit.path }]), guideList]}
>
  <div class="article" data-kit={kit.id}>
    <div class="topbar">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">n-uf</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{kit.name}</span>
      </nav>
    </div>

    <main>
      <article class="paper plain" aria-labelledby="guides-title">
        <div class="leaf-body">
          <header class="title-block">
            <p class="kicker">Guides · {kit.name}</p>
            <h1 id="guides-title">{kit.h1}</h1>
          </header>

          {kit.about.map((paragraph: string) => <p set:html={inlineCodeHtml(paragraph)} />)}

          <p class="guides-actions">
            <a class="guides-site" href={kit.siteUrl} {...externalAttrs(kit.siteUrl)}>
              {kit.siteButton}
              <span class="ext-arrow" aria-hidden="true">
                <svg viewBox="0 0 10 10" width="10" height="10" focusable="false">
                  <path d="M2 8 8 2M3.5 2H8v4.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"></path>
                </svg>
              </span>
              <span class="sr-only">{newTabNote}</span>
            </a>
          </p>

          <div class="availability">
            <p>
              <strong>Not installable yet.</strong> The {kit.name} package is private, so you cannot add it to a project today.
              {siteHost} is built from it and shows the kit live.
            </p>
          </div>

          <h2>{kit.name} guides</h2>
          <ul class="guides-list">
            {
              articles.map((entry: Entry) => (
                <li>
                  <a href={articlePath(kit.id, entry.id)} set:html={inlineCodeHtml(entry.data.h1)} />
                  <span class="guide-note" set:html={inlineCodeHtml(entry.data.description)} />
                  {!isLive(entry) && (
                    <span class="scheduled">
                      {kindLabel[entry.data.kind]} · Scheduled for {dateText(entry.data.published)}
                    </span>
                  )}
                </li>
              ))
            }
          </ul>

          <h2>More from n-uf</h2>
          <p class="guides-more">
            {
              others.map((other: Kit, index: number) => (
                <>
                  {index > 0 && ' · '}
                  <a href={other.path}>{other.homeLabel}</a>
                </>
              ))
            }
            · <a href="/">all n-uf projects</a>
          </p>
        </div>
      </article>
    </main>
  </div>
</Layout>
