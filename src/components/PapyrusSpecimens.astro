---
/**
 * Real sheets made with papyrus: the two sample documents, scaled down like
 * thumbnails in a PDF viewer. The pages are the same HTML the standalone files
 * under /papyrus-samples/ (and their PDFs) are built from, see
 * src/components/papyrus-samples/documents.mjs. Each page is an element with
 * the papyrus page class, sized by sheetCss() at build time.
 */
import { SAMPLES_DIR, paperCss, sampleDocs, scopedSheetCss } from './papyrus-samples/documents.mjs';
// Bytes of each committed PDF, written by scripts/papyrus-samples.mjs --pdf and checked
// against the PDFs by --check (a bundled JSON import, so it does not depend on the cwd)
import pdfSizes from './papyrus-samples/pdf-sizes.json';

import { siteUrl } from '../data/projects';

// The links of the sheets point at the sample files. The page's PDFs are printed from a local preview, where
// a relative link would be written into the PDF as that preview's address: the print build
// (scripts/papyrus-samples.mjs sets PAPYRUS_PRINT) links to the files on the site itself.
const printBuild: boolean = process.env.PAPYRUS_PRINT === '1';
const sampleHref = (path: string): string =>
  printBuild ? new URL(`/${SAMPLES_DIR}/${path}`, siteUrl).href : `/${SAMPLES_DIR}/${path}`;

const formats: Record<string, string> = { a4: 'A4', letter: 'Letter', slide: '16:9' };

const docs = sampleDocs.map((doc) => {
  const bytes: number = (pdfSizes as Record<string, number>)[doc.pdf];
  const count: number = doc.pages.length;
  return {
    ...doc,
    count,
    // The set header: "Fact sheet" over "A4 · 2 pages  ↓ PDF 169 KB"
    shortName: doc.name.replace(/^papyrus /, '').replace(/^./, (c: string) => c.toUpperCase()),
    meta: `${formats[doc.sheetKey]} · ${count} ${doc.unit}${count === 1 ? '' : 's'}`,
    pdfKb: `${Math.max(1, Math.round(bytes / 1024))} KB`,
  };
});

// Two labelled groups: the documents on paper sheets, the slides
const groups = [
  { id: 'documents', label: 'Documents', docs: docs.filter((doc) => doc.sheetKey !== 'slide') },
  { id: 'slides', label: 'Slides', docs: docs.filter((doc) => doc.sheetKey === 'slide') },
];

// sheetCss() sizes the page; only its page rule is used here, scoped to the sheet's own class
const sheetCssScoped: string = [
  scopedSheetCss(sampleDocs[0].sheet, '.sample-a4'),
  scopedSheetCss(sampleDocs[1].sheet, '.sample-letter'),
  scopedSheetCss(sampleDocs[2].sheet, '.sample-slide'),
].join('\n');
const sheetStyles: string = `${paperCss}\n${sheetCssScoped}`;
---

<style is:inline set:html={sheetStyles}></style>

<div class="specimens">
  {
    groups.map((group) => (
      <div
        class="group"
        role="group"
        aria-labelledby={`specimens-${group.id}`}
      >
        <p class="group-label" id={`specimens-${group.id}`}>
          {group.label}
        </p>
        <div class="sets">
          {group.docs.map((doc) => (
            <figure class="set" style={`--n:${doc.count}`} data-sheets={doc.count} aria-label={doc.accessibleName}>
              <figcaption class="setline">
                <span class="docname">{doc.shortName}</span>
                <span class="setmeta">
                  <span class="docmeta">{doc.meta}</span>
                  <a class="pdf" href={sampleHref(doc.pdf)} aria-label={`Download the ${doc.name} PDF, ${doc.pdfKb}`}>
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                      <path
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="square"
                        d="M8 1.75v8.5M4.25 6.5 8 10.25l3.75-3.75M2.25 13.75h11.5"
                      />
                    </svg>
                    <span>PDF</span>
                    <span class="pdf-size">{doc.pdfKb}</span>
                  </a>
                </span>
              </figcaption>
              <div class="sheets">
                {doc.pages.map((html, index) => (
                  <div class="sheet" title={`${doc.sizeLabel} · ${doc.unit} ${index + 1} of ${doc.count}`}>
                    <div
                      class={`sheet-box sample sample-${doc.sheetKey}`}
                      style={`--sw:${doc.sheet.viewport.width}px;--sh:${doc.sheet.viewport.height}px`}
                    >
                      {/* The sheet is a picture of the document: the figure and link names describe it */}
                      <div aria-hidden="true">
                        <Fragment set:html={html} />
                      </div>
                      <a
                        class="open"
                        href={sampleHref(`${doc.html}${index > 0 ? `#${doc.id}-page-${index + 1}` : ''}`)}
                        aria-label={`Open the ${doc.name}, ${doc.unit} ${index + 1} of ${doc.count}, at full size`}
                      />
                    </div>
                  </div>
                ))}
              </div>
            </figure>
          ))}
        </div>
      </div>
    ))
  }
</div>

<script is:inline>
  // iOS Safari resolves the CSS scale below (tan(atan2(100cqw, var(--sw)))) wrongly or not at all, which leaves a
  // full-size sheet in a small box: a white corner. Measure each box instead and give its sheet the scale (--k).
  // Measured once here, right after the markup, so the first paint is right; a ResizeObserver keeps it right when
  // the box changes (window width, A4/Letter, page and web views). The CSS formula stays for when scripts are off.
  (() => {
    const boxes = document.querySelectorAll('.specimens .sheet-box');
    const fit = (box) => {
      const sheetWidth = parseFloat(box.style.getPropertyValue('--sw'));
      // the fractional width (clientWidth rounds, which left a 1px line of box at a dark slide's edge)
      const boxWidth = box.getBoundingClientRect().width;
      if (!sheetWidth || !boxWidth) return;
      box.style.setProperty('--k', String(boxWidth / sheetWidth));
      box.setAttribute('data-k', '');
    };
    boxes.forEach(fit);
    if ('ResizeObserver' in window) {
      const observer = new ResizeObserver((entries) => entries.forEach((entry) => fit(entry.target)));
      boxes.forEach((box) => observer.observe(box));
    }
  })();
</script>

<style>
  .specimens {
    /* Wider than the text column, so the sheets are big enough to read */
    position: relative;
    left: 50%;
    width: min(1040px, calc(100vw - 48px));
    margin: 0 0 56px;
    translate: -50% 0;
    container: specimens / inline-size;
  }

  /* On a sheet of the paged view the specimens fill the sheet's text column */
  :global(.doc[data-view='pages']) .specimens {
    left: 0;
    width: 100%;
    margin: 0;
    translate: none;
  }

  /* Two labelled groups, Documents and Slides. In a group each document is a set: its name line,
     then its sheets under it, on a common top edge. */
  .group + .group {
    margin-top: 48px;
  }

  .group-label {
    margin: 0 0 16px;
    padding-top: 12px;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    color: var(--faint);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .sets {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 44px 28px;
    align-items: start;
  }

  .set {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    margin: 0;
  }

  /* A set spans as many columns as it has sheets (up to the three of the grid) */
  .set[data-sheets='2'] {
    grid-column: span 2;
  }

  .set[data-sheets='3'] {
    grid-column: 1 / -1;
  }

  .sheets {
    display: grid;
    grid-template-columns: repeat(var(--n, 1), minmax(0, 1fr));
    gap: 28px;
    align-items: start;
  }

  .sheet {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .sheet-box {
    flex: none;
  }

  /* A fixed box for each sheet, so scaling the page inside it moves nothing */
  .sheet-box {
    position: relative;
    container-type: inline-size;
    width: 100%;
    aspect-ratio: var(--sw-n) / var(--sh-n);
    overflow: hidden;
    border-radius: 2px;
    background: #fbfaf6;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.35),
      0 22px 60px -12px rgb(0 0 0 / 0.65);
  }

  .sample-a4 {
    --sw-n: 794;
    --sh-n: 1123;
  }

  .sample-letter {
    --sw-n: 816;
    --sh-n: 1056;
  }

  .sample-slide {
    --sw-n: 960;
    --sh-n: 540;
  }

  /* The sheet keeps its real size (sheetCss) and is scaled to the box's width */
  .sheet-box :global(.pdf-page) {
    position: absolute;
    top: 0;
    left: 0;
    margin: 0;
    box-shadow: none;
    transform-origin: 0 0;
    transform: scale(0.4);
    transform: scale(tan(atan2(100cqw, var(--sw))));
  }

  /* With scripts on, the measured scale (see the script above) wins over the formula, which iOS Safari gets wrong.
     Screen only: print keeps its zoom rule below. */
  @media screen {
    .sheet-box[data-k] :global(.pdf-page) {
      transform: scale(var(--k));
    }
  }

  .open {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* The link fills the box and the box clips, so the ring is drawn on the box itself.
     Without :has() (Firefox before 121) the link keeps its own ring, drawn inside. */
  .open:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -3px;
  }

  @supports selector(:has(a)) {
    .sheet-box:has(.open:focus-visible) {
      outline: 2px solid var(--ink);
      outline-offset: 3px;
    }

    .open:focus-visible {
      outline: none;
    }
  }

  /* The header of a set is the same two fixed lines everywhere, left over its first sheet, so every
     row's sheets start on one line: the name in ink, then what it is in muted and the PDF link.
     Nothing wraps (the PDF's size is dropped before the page count when the column is narrow). */
  /* Screen only: containment makes Chromium print the scaled sheets inside it clipped */
  @media screen {
    .set {
      container: set / inline-size;
    }
  }

  @media print {
    .set[data-sheets='1'] .pdf-size {
      display: none;
    }

    .sheet-box {
      box-shadow: none;
    }

    /* A transform scales only what is painted: the sheet keeps its full height in the layout, and
       Chromium cuts what lies below the page's end when it prints (the lower thumbnails lost their
       text). zoom scales the layout too, so the sheet takes the thumbnail's height. */
    .sheet-box :global(.pdf-page) {
      transform: none;
      zoom: tan(atan2(100cqw, var(--sw)));
    }
  }

  .setline {
    display: grid;
    grid-template-rows: 20px 20px;
    margin: 0;
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 20px;
    white-space: nowrap;
  }

  .docname {
    overflow: hidden;
    color: var(--ink);
    text-overflow: ellipsis;
  }

  .setmeta {
    display: flex;
    align-items: center;
    gap: 10px;
    overflow: hidden;
  }

  .docmeta {
    color: var(--muted);
  }

  a.pdf {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  a.pdf svg {
    flex: none;
  }

  @container set (max-width: 209px) {
    .pdf-size {
      display: none;
    }
  }

  /* On a sheet of the paged view the first label sits right under the running head, which has the rule */
  :global(.doc[data-view='pages']) .group:first-child .group-label {
    padding-top: 0;
    border-top: 0;
  }

  @media (max-width: 639px) {
    .specimens {
      left: 0;
      width: 100%;
      translate: none;
    }
  }

  /* The breakpoints follow the width the specimens have (a container), not the window's:
     the paged view puts them on a sheet whose text column is about 700px */
  @container specimens (max-width: 639px) {
    .sets {
      grid-template-columns: minmax(0, 1fr);
    }

    .set[data-sheets] {
      grid-column: auto;
    }

    /* One sheet across, readable; the name line wraps */
    .sheets {
      --n: 1;
    }

    .group + .group {
      margin-top: 48px;
    }
  }

  /* Four documents on one sheet of paper: a little tighter to fit A4 and Letter */
  @container specimens (min-width: 640px) {
    :global(.doc[data-view='pages']) .sets {
      row-gap: 40px;
    }

    :global(.doc[data-view='pages']) .sheets {
      gap: 20px 28px;
    }
  }
</style>
