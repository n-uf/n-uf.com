---
/**
 * Real sheets made with papyrus: the two sample documents, scaled down like
 * thumbnails in a PDF viewer. The pages are the same HTML the standalone files
 * under /papyrus-samples/ (and their PDFs) are built from, see
 * src/components/papyrus-samples/documents.mjs. Each page is an element with
 * the papyrus page class, sized by sheetCss() at build time.
 */
import { SAMPLES_DIR, paperCss, sampleDocs, scopedSheetCss } from './papyrus-samples/documents.mjs';
// Bytes of each committed PDF, written by scripts/papyrus-samples.mjs --pdf and checked
// against the PDFs by --check (a bundled JSON import, so it does not depend on the cwd)
import pdfSizes from './papyrus-samples/pdf-sizes.json';

const samplesBase: string = `/${SAMPLES_DIR}/`;

const docs = sampleDocs.map((doc) => {
  const bytes: number = (pdfSizes as Record<string, number>)[doc.pdf];
  const count: number = doc.pages.length;
  return {
    ...doc,
    count,
    pdfLabel: `PDF · ${count} ${count === 1 ? 'page' : 'pages'} · ${Math.max(1, Math.round(bytes / 1024))} KB`,
  };
});

// sheetCss() sizes the page; only its page rule is used here, scoped to the sheet's own class
const sheetCssScoped: string = [
  scopedSheetCss(sampleDocs[0].sheet, '.sample-a4'),
  scopedSheetCss(sampleDocs[1].sheet, '.sample-letter'),
].join('\n');
const sheetStyles: string = `${paperCss}\n${sheetCssScoped}`;
---

<style is:inline set:html={sheetStyles}></style>

<div class="specimens">
  <div class="specimen-grid">
    {
      docs.map((doc) => (
        <figure class="specimen" data-pages={doc.count} aria-label={doc.accessibleName}>
          <div class="sheets">
            {doc.pages.map((html, index) => (
              <div class="sheet">
                <div
                  class={`sheet-box sample sample-${doc.sheetKey}`}
                  style={`--sw:${doc.sheet.viewport.width}px;--sh:${doc.sheet.viewport.height}px`}
                >
                  {/* The sheet is a picture of the document: the figure and link names describe it */}
                  <div aria-hidden="true">
                    <Fragment set:html={html} />
                  </div>
                  <a
                    class="open"
                    href={`${samplesBase}${doc.html}${index > 0 ? `#${doc.id}-page-${index + 1}` : ''}`}
                    aria-label={`Open the ${doc.name}, page ${index + 1} of ${doc.count}, at full size`}
                  />
                </div>
                <p class="cap">
                  {doc.sizeLabel} · page {index + 1} of {doc.count}
                </p>
              </div>
            ))}
          </div>
          <figcaption class="docline">
            <span class="docname">{doc.name}</span>
            <a class="pdf" href={`${samplesBase}${doc.pdf}`}>
              {doc.pdfLabel}
            </a>
          </figcaption>
        </figure>
      ))
    }
  </div>
</div>

<style>
  .specimens {
    /* Wider than the text column, so the sheets are big enough to read */
    position: relative;
    left: 50%;
    width: min(1040px, calc(100vw - 48px));
    margin: 0 0 56px;
    translate: -50% 0;
    container-type: inline-size;
  }

  /* On a sheet of the paged view the specimens fill the sheet's text column */
  :global(.doc[data-view='pages']) .specimens {
    left: 0;
    width: 100%;
    margin: 0;
    translate: none;
  }

  .specimen-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    align-items: start;
  }

  .specimen {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    margin: 0;
  }

  .specimen[data-pages='2'] {
    grid-column: span 2;
  }

  .sheets {
    display: grid;
    grid-template-columns: repeat(var(--n, 1), minmax(0, 1fr));
    gap: 28px;
    align-items: start;
  }

  .specimen[data-pages='2'] .sheets {
    --n: 2;
  }

  .sheet {
    min-width: 0;
  }

  /* A fixed box for each sheet, so scaling the page inside it moves nothing */
  .sheet-box {
    position: relative;
    container-type: inline-size;
    width: 100%;
    aspect-ratio: var(--sw-n) / var(--sh-n);
    overflow: hidden;
    border-radius: 2px;
    background: #fbfaf6;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.35),
      0 22px 60px -12px rgb(0 0 0 / 0.65);
  }

  .sample-a4 {
    --sw-n: 794;
    --sh-n: 1123;
  }

  .sample-letter {
    --sw-n: 816;
    --sh-n: 1056;
  }

  /* The sheet keeps its real size (sheetCss) and is scaled to the box's width */
  .sheet-box :global(.pdf-page) {
    position: absolute;
    top: 0;
    left: 0;
    margin: 0;
    box-shadow: none;
    transform-origin: 0 0;
    transform: scale(0.4);
    transform: scale(tan(atan2(100cqw, var(--sw))));
  }

  .open {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* The link fills the box and the box clips, so the ring is drawn on the box itself.
     Without :has() (Firefox before 121) the link keeps its own ring, drawn inside. */
  .open:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -3px;
  }

  @supports selector(:has(a)) {
    .sheet-box:has(.open:focus-visible) {
      outline: 2px solid var(--ink);
      outline-offset: 3px;
    }

    .open:focus-visible {
      outline: none;
    }
  }

  .cap,
  .docline {
    margin: 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.45;
  }

  .docline {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    padding-top: 10px;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }

  .docname {
    color: var(--ink);
  }

  .sheet .cap {
    margin-top: 12px;
  }

  a.pdf {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 639px) {
    .specimens {
      left: 0;
      width: 100%;
      translate: none;
    }
  }

  /* The breakpoints follow the width the specimens have (a container), not the window's:
     the paged view puts them on a sheet whose text column is about 700px */
  @container (max-width: 851px) {
    .specimen-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .specimen[data-pages='1'] {
      grid-column: 1 / -1;
      width: calc(50% - 14px);
      justify-self: center;
    }
  }

  @container (max-width: 591px) {
    .specimen-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 44px;
    }

    .specimen[data-pages='2'],
    .specimen[data-pages='1'] {
      grid-column: auto;
      width: 100%;
    }

    .specimen[data-pages='2'] .sheets {
      --n: 1;
      gap: 28px;
    }
  }

  /* Paged view: three columns from 640px of sheet, one below */
  @container (min-width: 640px) {
    :global(.doc[data-view='pages']) .specimen-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }

    :global(.doc[data-view='pages']) .specimen[data-pages='2'] {
      grid-column: span 2;
      width: auto;
    }

    :global(.doc[data-view='pages']) .specimen[data-pages='1'] {
      grid-column: auto;
      width: auto;
      justify-self: stretch;
    }

    :global(.doc[data-view='pages']) .specimen[data-pages='2'] .sheets {
      --n: 2;
      gap: 20px;
    }
  }

  @container (min-width: 592px) and (max-width: 639px) {
    :global(.doc[data-view='pages']) .specimen-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 44px;
    }

    :global(.doc[data-view='pages']) .specimen[data-pages='2'],
    :global(.doc[data-view='pages']) .specimen[data-pages='1'] {
      grid-column: auto;
      width: 100%;
    }

    :global(.doc[data-view='pages']) .specimen[data-pages='2'] .sheets {
      --n: 1;
      gap: 28px;
    }
  }
</style>
