---
import { studioName } from '../data/projects';

interface Props {
  missingSegment?: number;
  size: string;
}

const { missingSegment, size } = Astro.props;
const parts: readonly string[] = studioName.split('-');
const lead: string = parts[0] ?? 'n';
const tail: string = parts[1] ?? 'uf';
const segments: readonly number[] = [0, 1, 2, 3, 4];
---

<span class="wordmark" style={`--wm-size: ${size}`} aria-hidden="true">
  <span class="wm-lead">{lead}</span><span class="hyphen">{
    segments.map((index: number) => (
      <span
        class:list={['seg', index === missingSegment && 'is-missing']}
        data-bar={String(index)}
      />
    ))
  }</span><span class="wm-tail">{tail}</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    color: var(--ink);
    font-family: var(--sans);
    font-size: var(--wm-size);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1;
    white-space: nowrap;
  }

  .wm-lead {
    margin-right: -0.006em;
  }

  .wm-tail {
    letter-spacing: -0.06em;
  }

  .hyphen {
    display: inline-flex;
    align-self: baseline;
    width: 0.42em;
    height: 0.09em;
    margin: 0 0.05em;
    gap: 0;
    overflow: hidden;
    border-radius: 2px;
    transform: translateY(calc(0.045em - 0.5ex));
  }

  .seg {
    flex: 1 1 0;
    min-width: 0;
    border-radius: 0;
    background: var(--accent);
  }

  .seg + .seg {
    margin-left: -1px;
  }

  .seg[data-bar='0'] { --accent: var(--accent-0); }
  .seg[data-bar='1'] { --accent: var(--accent-1); }
  .seg[data-bar='2'] { --accent: var(--accent-2); }
  .seg[data-bar='3'] { --accent: var(--accent-3); }
  .seg[data-bar='4'] { --accent: var(--accent-4); }

  .seg.is-missing {
    background: transparent;
  }
</style>
