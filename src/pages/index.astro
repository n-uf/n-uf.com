---
import Layout from '../layouts/Layout.astro';
import {
  listedProjects,
  studioSummary,
  githubOrgUrl,
  type Project,
} from '../data/projects';

const pageTitle: string = 'n-uf';
const pageDescription: string = studioSummary;
const listed: readonly Project[] = listedProjects();
const bars: readonly number[] = [0, 1, 2, 3, 4];

function metaLine(project: Project): string {
  const parts: string[] = [new URL(project.url).host];
  if (project.repo !== undefined) {
    const repo: URL = new URL(project.repo);
    const path: string = repo.pathname.replace(/\/$/, '');
    parts.push(`${repo.host}${path}`);
  }
  if (project.npm !== undefined) {
    parts.push(project.npm);
  }
  return parts.join(' · ');
}
---

<Layout title={pageTitle} description={pageDescription} path="/">
  <div class="page">
    <header class="intro">
      <div class="mark" aria-hidden="true">
        {bars.map((index: number) => (
          <span class="bar" data-bar={String(index)}></span>
        ))}
      </div>
      <h1 class="hero">{studioSummary}</h1>
    </header>

    <div class="air" aria-hidden="true"></div>

    <main>
      <ul class="projects">
        {
          listed.map((project: Project, index: number) => (
            <li class="project">
              <article>
                <a class="row" href={project.url} data-bar={String(index % bars.length)}>
                  <div class="copy">
                    <h2 class="name">{project.name}</h2>
                    <p class="tagline">{project.tagline}</p>
                    <p class="meta">{metaLine(project)}</p>
                  </div>
                </a>
              </article>
            </li>
          ))
        }
      </ul>
    </main>

    <footer class="foot">
      <a href={githubOrgUrl}>github.com/n-uf</a>
      {
        listed.map((project: Project) => (
          <span>
            {' · '}
            <a href={project.url}>{project.name}</a>
          </span>
        ))
      }
    </footer>
  </div>
</Layout>
