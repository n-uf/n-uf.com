---
import Layout from '../layouts/Layout.astro';
import Wordmark from '../components/Wordmark.astro';
import {
  listedProjects,
  studioSummary,
  githubOrgUrl,
  type Project,
} from '../data/projects';

const pageTitle: string = 'n-uf';
const pageDescription: string = studioSummary;
const listed: readonly Project[] = listedProjects();
const wordmarkSize: string = 'clamp(84px, 18vw, 200px)';
---

<Layout title={pageTitle} description={pageDescription} path="/">
  <div class="page home">
    <h1 class="wordmark-heading" aria-label="n-uf">
      <Wordmark size={wordmarkSize} />
    </h1>

    <main>
      <ul class="projects">
        {
          listed.map((project: Project, index: number) => {
            const host: string = new URL(project.url).host;
            return (
              <li data-bar={String(index)}>
                <a class="name" href={project.url}>
                  {project.name}
                </a>
                <p class="desc">{project.tagline}</p>
                <p class="meta">
                  <a href={project.url}>{host}</a>
                </p>
              </li>
            );
          })
        }
      </ul>
    </main>

    <p class="foot">
      {studioSummary}
      {' · '}
      <a href={githubOrgUrl}>github.com/n-uf</a>
    </p>
  </div>
</Layout>
