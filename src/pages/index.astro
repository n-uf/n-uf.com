---
import Layout from '../layouts/Layout.astro';
import {
  projects,
  studioName,
  studioSummary,
  githubOrgUrl,
  type Project,
} from '../data/projects';

const pageTitle: string = 'n-uf';
const pageDescription: string =
  'A small studio that builds open-source interface tools. Live projects: hypr-tiling, DOODL, and debugsy.';

function npmUrl(name: string): string {
  return `https://www.npmjs.com/package/${name}`;
}
---

<Layout title={pageTitle} description={pageDescription} path="/">
  <div class="mx-auto flex min-h-screen max-w-5xl flex-col px-6 py-12">
    <header>
      <div class="mb-8 flex gap-1.5" aria-hidden="true">
        <span class="h-1 w-8 bg-pink-400"></span>
        <span class="h-1 w-8 bg-orange-400"></span>
        <span class="h-1 w-8 bg-amber-400"></span>
        <span class="h-1 w-8 bg-emerald-400"></span>
        <span class="h-1 w-8 bg-cyan-400"></span>
      </div>
      <p class="font-mono text-[11px] uppercase tracking-[0.28em] text-slate-500">
        n-uf.com
      </p>
      <h1 class="mt-3 text-4xl font-medium tracking-tight text-slate-100">
        {studioName}
      </h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-slate-400">
        {studioSummary}
      </p>
    </header>

    <main class="mt-16 flex-1">
      <h2 class="font-mono text-[11px] uppercase tracking-[0.22em] text-slate-500">
        Projects
      </h2>
      <ul class="mt-6 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project: Project) => (
            <li class="flex flex-col border border-slate-800 bg-slate-900/70 p-5">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="text-base font-medium text-slate-100">
                  <a
                    href={project.url}
                    class="text-slate-100 underline-offset-4 hover:text-cyan-300 hover:underline"
                  >
                    {project.name}
                  </a>
                </h3>
                <span class="font-mono text-[10px] uppercase tracking-wider text-emerald-400">
                  {project.status}
                </span>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-slate-200">{project.tagline}</p>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">
                {project.description}
              </p>
              <p class="mt-5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[11px]">
                <a
                  href={project.url}
                  class="text-slate-400 underline-offset-4 hover:text-cyan-300 hover:underline"
                >
                  {new URL(project.url).host}
                </a>
                {project.repo !== undefined && (
                  <a
                    href={project.repo}
                    class="text-slate-400 underline-offset-4 hover:text-cyan-300 hover:underline"
                  >
                    Repository
                  </a>
                )}
                {project.npm !== undefined && (
                  <a
                    href={npmUrl(project.npm)}
                    class="text-slate-400 underline-offset-4 hover:text-cyan-300 hover:underline"
                  >
                    {project.npm}
                  </a>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </main>

    <footer class="mt-16 border-t border-slate-800 pt-6 text-sm text-slate-500">
      <a
        href={githubOrgUrl}
        class="text-slate-300 underline-offset-4 hover:text-cyan-300 hover:underline"
      >
        GitHub
      </a>
      <span class="mx-2 text-slate-700" aria-hidden="true">/</span>
      <span>n-uf</span>
    </footer>
  </div>
</Layout>
