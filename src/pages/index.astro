---
import Layout from '../layouts/Layout.astro';
import Wordmark from '../components/Wordmark.astro';
import {
  listedProjects,
  studioSummary,
  githubOrgUrl,
  type Project,
} from '../data/projects';

// What a search result shows: name what is here (Google cuts titles near 60 characters,
// descriptions near 155). The studio summary stays in the footer and the Organization data.
const pageTitle: string = 'n-uf: React UI kits, web libraries and macOS tools';
const pageDescription: string =
  'React UI kits (harbuz, kavun, dynia), a tiling layout, a canvas drawing library, a React debug panel and cl_audit, a Mac app for Claude usage limits.';
const listed: readonly Project[] = listedProjects();
const wordmarkSize: string = 'clamp(84px, 18vw, 200px)';

// Structured data: the projects as a list, each with its own site
const projectList: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'n-uf projects',
  itemListElement: listed.map((project: Project, index: number) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: project.name,
    url: project.url,
    description: project.tagline,
  })),
};

function repoLine(repo: string): string {
  const url: URL = new URL(repo);
  const path: string = url.pathname.replace(/\/$/, '');
  return `${url.host}${path}`;
}
---

<Layout title={pageTitle} description={pageDescription} path="/" structuredData={[projectList]}>
  <div class="page home">
    <h1 class="wordmark-heading" aria-label="n-uf">
      <Wordmark size={wordmarkSize} />
    </h1>

    <main>
      <ul class="projects">
        {
          listed.map((project: Project, index: number) => {
            const host: string = new URL(project.url).host;
            const repoHref: string | undefined = project.repo;
            const repoText: string | undefined =
              repoHref === undefined ? undefined : repoLine(repoHref);
            return (
              <li data-bar={String(index % 5)}>
                <h2 class="name-heading">
                  <a class="name" href={project.url}>
                    {project.name}
                  </a>
                </h2>
                <p class="desc">{project.tagline}</p>
                <p class="meta">
                  <a href={project.url}>{host}</a>
                </p>
                {repoHref !== undefined && repoText !== undefined && (
                  <p class="meta">
                    <a href={repoHref}>{repoText}</a>
                  </p>
                )}
              </li>
            );
          })
        }
      </ul>
    </main>

    <div class="foot">
      <p class="foot-summary">{studioSummary}</p>
      <p class="foot-link">
        <a href={githubOrgUrl}>github.com/n-uf</a>
      </p>
    </div>
  </div>
</Layout>
