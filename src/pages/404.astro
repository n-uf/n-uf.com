---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found — n-uf"
  description="This address is not on n-uf.com."
  path="/404"
  robots="noindex"
>
  <div class="mx-auto flex min-h-screen max-w-5xl flex-col px-6 py-12">
    <header>
      <div class="mb-8 flex gap-1.5" aria-hidden="true">
        <span class="h-1 w-8 bg-pink-400"></span>
        <span class="h-1 w-8 bg-orange-400"></span>
        <span class="h-1 w-8 bg-amber-400"></span>
        <span class="h-1 w-8 bg-emerald-400"></span>
        <span class="h-1 w-8 bg-cyan-400"></span>
      </div>
      <p class="font-mono text-[11px] uppercase tracking-[0.28em] text-slate-500">404</p>
      <h1 class="mt-3 text-4xl font-medium tracking-tight text-slate-100">Page not found</h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-slate-400">
        This address is not on n-uf.com.
      </p>
      <p class="mt-8">
        <a
          href="/"
          class="text-sm text-cyan-300 underline-offset-4 hover:underline"
        >
          Back to the homepage
        </a>
      </p>
    </header>
  </div>
</Layout>
