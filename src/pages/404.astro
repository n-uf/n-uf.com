---
import Layout from '../layouts/Layout.astro';
import Wordmark from '../components/Wordmark.astro';

const wordmarkSize: string = 'clamp(56px, 10vw, 96px)';
const missingSegment: number = 2;
---

<Layout
  title="404 — page not found."
  description="404 — page not found."
  path="/404"
  robots="noindex"
>
  <div class="page">
    <Wordmark size={wordmarkSize} missingSegment={missingSegment} />
    <h1 class="miss">
      404 — page not found. <a href="/">n-uf.com</a>
    </h1>
  </div>
</Layout>
