---
import Layout from '../layouts/Layout.astro';

const bars: readonly number[] = [0, 1, 2, 3, 4];
const missingBar: number = 2;
---

<Layout
  title="404 — n-uf"
  description="Nothing here."
  path="/404"
  robots="noindex"
>
  <div class="page">
    <header class="intro">
      <div class="mark" aria-hidden="true">
        {
          bars.map((index: number) => (
            <span
              class:list={['bar', index === missingBar && 'is-missing']}
              data-bar={String(index)}
            />
          ))
        }
      </div>
      <div class="topline" aria-hidden="true"></div>
      <h1 class="code">404</h1>
      <p class="miss">Nothing here. <a href="/">n-uf.com</a></p>
    </header>
  </div>
</Layout>
