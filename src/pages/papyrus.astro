---
import Layout from '../layouts/Layout.astro';
import PapyrusLeaf from '../components/PapyrusLeaf.astro';
import PapyrusSpecimens from '../components/PapyrusSpecimens.astro';
import { SHEETS } from '@n-uf/papyrus';
import { SAMPLES_DIR, scopedSheetCss } from '../components/papyrus-samples/documents.mjs';
import pdfSizes from '../components/papyrus-samples/pdf-sizes.json';
import { siteUrl, studioId } from '../data/projects';

// The page is a stack of sheets. The split is fixed in the markup below; keep `leafTotal` equal
// to the number of <PapyrusLeaf> elements (and "pageCount" in scripts/papyrus-page.config.json).
const leafTotal: number = 5;

// The page as a PDF, once per sheet format: the paged page itself, printed by papyrus pdf
// (scripts/papyrus-samples.mjs --pdf). The sizes are recorded in pdf-sizes.json.
const pagePdfs = (['a4', 'letter'] as const).map((key) => {
  const file: string = `papyrus-${key}.pdf`;
  const bytes: number | undefined = (pdfSizes as Record<string, number>)[file];
  const format: string = key === 'a4' ? 'A4' : 'US Letter';
  const size: string = bytes ? ` · ${Math.max(1, Math.round(bytes / 1024))} KB` : '';
  return {
    key,
    file,
    href: `/${SAMPLES_DIR}/${file}`,
    label: `${format} · ${leafTotal} pages${size}`,
  };
});
const pagePdf = pagePdfs[0];

// Sheet sizes from papyrus' sheetCss(): only its page rule is used, scoped to the sheets of this
// page (the @page, print and canvas rules of sheetCss would reshape the whole site page).
// Switched by data-sheet (a4 | letter) on the wrapper; fixed boxes only where the sheet fits.
const sheetRule = (sheet: typeof SHEETS.A4, key: string): string => {
  const scoped: string = scopedSheetCss(sheet, '.doc');
  const from = '.doc .pdf-page';
  if (!scoped.startsWith(from)) throw new Error('scopedSheetCss() no longer starts with the scoped page selector');
  const target = `.doc[data-sheet='${key}'][data-view='pages'] .leaf-set > .pdf-page.leaf`;
  return scoped.replace(from, target);
};
const printRule = (sheet: typeof SHEETS.A4, key: string): string =>
  `.doc[data-sheet='${key}'][data-view='pages'] .leaf-set > .pdf-page.leaf { width: ${sheet.width}; height: ${sheet.height}; min-height: 0; box-sizing: border-box; margin: 0; box-shadow: none; page-break-after: always; break-after: page; break-inside: avoid; }`;
const leafCss: string = `
@media screen and (min-width: 860px) {
  ${sheetRule(SHEETS.A4, 'a4')}
  ${sheetRule(SHEETS.LETTER, 'letter')}
}
.doc[data-view='pages'] .leaf-set > .pdf-page.leaf {
  margin: 0 auto 28px;
  box-shadow: 0 1px 2px rgb(0 0 0 / 0.35), 0 22px 60px -12px rgb(0 0 0 / 0.65);
}
@media print {
  ${printRule(SHEETS.A4, 'a4')}
  ${printRule(SHEETS.LETTER, 'letter')}
  .doc[data-view='pages'] .leaf-set > .pdf-page.leaf:last-child { page-break-after: auto; break-after: auto; }
}
`;

const pageTitle: string = 'papyrus: HTML and React documents to A4 and Letter PDF';
const pageDescription: string =
  'papyrus lays out documents in HTML or React on A4 or Letter sheets and prints them to PDF, checking the page count so a broken render is never saved.';
const pagePath: string = '/papyrus';
const pageUrl: string = new URL(pagePath, siteUrl).href;
const repoUrl: string = 'https://github.com/n-uf/papyrus';
const engineNpm: string = 'https://www.npmjs.com/package/@n-uf/papyrus';
const reactNpm: string = 'https://www.npmjs.com/package/@n-uf/papyrus-react';
const engineChangelog: string = `${repoUrl}/blob/main/packages/papyrus/CHANGELOG.md`;
const reactChangelog: string = `${repoUrl}/blob/main/packages/papyrus-react/CHANGELOG.md`;
const licenceUrl: string = 'https://polyformproject.org/licenses/perimeter/1.0.1';

// The library's own node: the Organization node comes from the layout
const software: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  '@id': `${pageUrl}#software`,
  name: 'papyrus',
  description: pageDescription,
  url: pageUrl,
  codeRepository: repoUrl,
  programmingLanguage: ['JavaScript', 'TypeScript'],
  runtimePlatform: 'Node.js',
  license: licenceUrl,
  author: { '@id': studioId },
  publisher: { '@id': studioId },
};

const breadcrumbs: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'n-uf',
      item: `${siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'papyrus',
      item: pageUrl,
    },
  ],
};

const sheetSample: string = `import { SHEETS, sheetCss } from "@n-uf/papyrus";

const css = sheetCss(SHEETS.LETTER);                     // US Letter sheets
const alt = sheetCss(SHEETS.A4, { pageClass: "page" });  // your own page class`;

const tocSample: string = `import { docRegistry, numberToc } from "@n-uf/papyrus";

docRegistry.register({ id: "report", meta: { title: "Report", pageCount: 4, toc }, component: render });
numberToc(toc); // Map: entry id -> "1.", "2.", "A." (appendix) or null (skipped)`;

const configSample: string = `{
  "baseUrl": "file:///Users/me/resume/src/",
  "docUrl": "{id}.html",
  "outDir": "../dist",
  "docs": [{ "id": "resume", "sheet": "letter", "pageSelector": ".page", "pageCount": 3 }]
}`;

const reactSample: string = `<Logo name={<MyWordmark />} variantTextLines={{ home: ["MADE BY"] }} />
<DocumentFooter title="Report" copyright="© 2030 Acme" />
<TOCItem number="1" title="Intro" page="3" section="market" sectionColors={{ market: "rgb(14, 116, 144)" }} />`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  path={pagePath}
  structuredData={[software, breadcrumbs]}
>
  <div class="doc" data-view="pages" data-sheet="a4">
    <!-- Before the sheets, so a returning visitor gets the view and the format they chose without a flash.
         The URL (?view=web|pages, ?sheet=a4|letter) wins over the remembered choice. -->
    <script is:inline>
      (function () {
        var doc = document.currentScript.parentElement;
        var q = new URLSearchParams(location.search);
        function stored(key) {
          try {
            return localStorage.getItem(key);
          } catch (e) {
            return null;
          }
        }
        var view = q.get('view');
        if (view !== 'web' && view !== 'pages') view = stored('papyrus-view');
        if (view === 'web' || view === 'pages') doc.setAttribute('data-view', view);
        var sheet = q.get('sheet');
        if (sheet !== 'a4' && sheet !== 'letter') sheet = stored('papyrus-sheet');
        if (sheet === 'a4' || sheet === 'letter') doc.setAttribute('data-sheet', sheet);
      })();
    </script>

    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">n-uf</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">papyrus</span>
    </nav>

    <main>
      <article class="leaf-set">
        <style is:inline set:html={leafCss}></style>

        <PapyrusLeaf n={1} total={leafTotal} section="Introduction · Two packages">
        <h1>Documents in HTML, printed to PDF</h1>

        <p class="repo-row">
          <a class="repo" href={repoUrl}>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
              ></path>
            </svg>
            <span>Source on GitHub</span>
            <span class="repo-path">n-uf/papyrus</span>
          </a>
          <a
            class="repo pdf-link"
            href={pagePdf.href}
            download={pagePdf.file}
            type="application/pdf"
            data-a4-href={pagePdfs[0].href}
            data-a4-file={pagePdfs[0].file}
            data-a4-label={pagePdfs[0].label}
            data-letter-href={pagePdfs[1].href}
            data-letter-file={pagePdfs[1].file}
            data-letter-label={pagePdfs[1].label}
          >
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
                d="M8 1.75v8.5M4.25 6.5 8 10.25l3.75-3.75M2.25 13.75h11.5"
              ></path>
            </svg>
            <span>Download PDF</span>
            <span class="repo-path">{pagePdf.label}</span>
          </a>
          <!-- Two-state controls, one button each; shown by the script below (they do nothing without it) -->
          <button class="repo view-toggle" type="button" aria-pressed="false" hidden>
            <svg class="icon-web" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
                d="M2.25 3.25h11.5v9.5H2.25zM2.25 6.25h11.5"
              ></path>
            </svg>
            <svg class="icon-pages" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
                d="M3.75 1.75h8.5v12.5h-8.5zM6 5.25h4M6 8h4"
              ></path>
            </svg>
            <span class="toggle-label">Web view</span>
          </button>
          <button class="repo sheet-toggle" type="button" hidden>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
                d="M4.25 1.75h7.5v12.5h-7.5zM1.75 4.25v7.5M14.25 4.25v7.5"
              ></path>
            </svg>
            <span class="toggle-label">US Letter</span>
          </button>
        </p>

        <p>
          papyrus is a documents engine. You write a document as HTML or React pages. On screen each
          page is a sheet of A4 or US Letter paper, and the same pages print to a PDF. A report or a
          resume stays one source for the web and for print.
        </p>
        <p>
          It checks every PDF before writing it: the number of pages in the HTML, the PDF's own page
          count and the count you expect must agree. If they don't, for example because a page
          overflowed onto an extra sheet, the export stops instead of writing the file.
        </p>
        <p>
          papyrus is young. Versions are dates (YY.M.R), not semantic versions, so any release may
          break things. Pin an exact version and read the changelog before you upgrade.
        </p>

        <h2>Two packages, one version</h2>
        <ul>
          <li>
            <strong><a href={engineNpm}>@n-uf/papyrus</a></strong>, the engine. Plain ESM
            JavaScript with type declarations and no framework, so it runs in a plain HTML page, in a
            bundled app and in Node. It holds the page contract, the sheet sizes and print CSS, the
            document registry and the PDF exporter.
          </li>
          <li>
            <strong><a href={reactNpm}>@n-uf/papyrus-react</a></strong>, React components on top of
            the engine: page and content blocks, a document registry typed for React, and print
            styles. It ships TypeScript source.
          </li>
        </ul>
        <p>
          Both carry no brand, copy or content of their own; your documents supply those. They are
          released together at one version, on npmjs with provenance and on GitHub Packages.
        </p>
        </PapyrusLeaf>

        <PapyrusLeaf n={2} total={leafTotal} section="What papyrus prints">
          <PapyrusSpecimens />
        </PapyrusLeaf>

        <PapyrusLeaf n={3} total={leafTotal} section="One element, one sheet, one page">
        <h2>One element, one sheet, one page</h2>
        <p>
          Every element with the class <code>pdf-page</code> is one sheet on screen and one page in
          the PDF. <code>sheetCss()</code> sizes it to A4 or Letter and keeps one per printed page;
          on screen the sheets sit on a grey canvas.
        </p>
        <pre><code>{sheetSample}</code></pre>
        <p>
          Pages without a bundler can link the ready-made <code>@n-uf/papyrus/sheet-a4.css</code> or
          <code>sheet-letter.css</code> instead.
        </p>

        <h2>Numbered tables of contents</h2>
        <p>
          A document is registered with its title, expected page count and table of contents.
          <code>numberToc()</code> numbers the entries, appendices included.
        </p>
        <pre><code>{tocSample}</code></pre>
        </PapyrusLeaf>

        <PapyrusLeaf n={4} total={leafTotal} section="Export to PDF">
        <h2>Export to PDF</h2>
        <p>
          The <code>papyrus</code> command prints every document in a config file through headless
          Chromium (Playwright). The server that renders the documents must already be running
          (<code>--wait</code> gives it time to answer):
        </p>
        <pre><code>papyrus pdf --config papyrus.config.json</code></pre>
        <p>
          For plain HTML files no server is needed: point <code>baseUrl</code> at the folder.
        </p>
        <pre><code>{configSample}</code></pre>
        <ul>
          <li>
            <strong>Sheet:</strong> A4 by default, <code>"letter"</code> for the whole config or one
            document. It sets the viewport, the print CSS and the PDF paper.
          </li>
          <li>
            <strong>Pages:</strong> <code>pageSelector</code> names your page elements when they are
            not <code>.pdf-page</code>; <code>pageCount</code> is the number you expect.
          </li>
          <li>
            <strong>Fonts:</strong> web fonts are awaited before printing (up to 10 seconds), so
            pagination doesn't depend on load timing.
          </li>
          <li>
            <strong>Stale PDFs:</strong> list a document's source folders and
            <code>papyrus pdf --check</code> reports committed PDFs whose sources changed since they
            were printed.
          </li>
          <li>
            <strong>Browser:</strong> set <code>PAPYRUS_CHROMIUM_PATH</code> to print with an
            installed Chrome instead of Playwright's download.
          </li>
        </ul>
        <p>
          The same export runs from code with <code>renderPdf(browser, url, options)</code> from
          <code>@n-uf/papyrus/pdf</code>. <code>createPdfHandler</code> from
          <code>@n-uf/papyrus/server</code> renders a document to a downloadable PDF on request, in
          a serverless function or any server with a Web <code>Request</code>. In development, the
          Vite plugin <code>papyrusPdfPlugin</code> from <code>@n-uf/papyrus/vite</code> serves
          <code>/docs/&lt;id&gt;.pdf</code>.
        </p>

        </PapyrusLeaf>

        <PapyrusLeaf n={5} total={leafTotal} section="React components · Install">
        <h2>React components</h2>
        <p>
          <code>@n-uf/papyrus-react</code> gives you <code>PDFPage</code> and blocks for text,
          tables, lists, cards and indicators. <code>registerDoc</code> (from <code>/dossier</code>)
          registers a React document, <code>useDocParam</code> (from <code>/params</code>) keeps a
          document parameter in the URL, and <code>printStyles</code> (from <code>/styles</code>)
          holds the sheet CSS and print fixes. Branding is yours: <code>Logo</code> and
          <code>DocumentFooter</code> render only what you pass.
        </p>
        <pre><code>{reactSample}</code></pre>
        <p>
          With Tailwind v4, import the package's stylesheet:
          <code>@import "@n-uf/papyrus-react/tailwind.css"</code>.
        </p>

        <h2>Install</h2>
        <pre><code>pnpm add @n-uf/papyrus            # engine only, no bundler needed
pnpm add @n-uf/papyrus-react      # React components</code></pre>
        <p>
          In a Next.js app, add <code>@n-uf/papyrus-react</code> to <code>transpilePackages</code>.
          <code>playwright</code> and <code>vite</code> are optional peer dependencies, needed only
          for the PDF export and the Vite plugin.
        </p>
        <p>
          Source on GitHub: <a href={repoUrl}>n-uf/papyrus</a>. On npm:
          <a href={engineNpm}>@n-uf/papyrus</a> and <a href={reactNpm}>@n-uf/papyrus-react</a>.
          Changelogs: <a href={engineChangelog}>engine</a>,
          <a href={reactChangelog}>React components</a>. Licence:
          <a href={licenceUrl}>PolyForm Perimeter 1.0.1</a>.
        </p>
        </PapyrusLeaf>
      </article>
    </main>

    <script is:inline>
      (function () {
        var doc = document.querySelector('.doc');
        var viewBtn = doc.querySelector('.view-toggle');
        var sheetBtn = doc.querySelector('.sheet-toggle');
        var pdf = doc.querySelector('.pdf-link');
        function remember(key, value) {
          try {
            localStorage.setItem(key, value);
          } catch (e) {}
        }
        function sync() {
          var view = doc.getAttribute('data-view');
          var sheet = doc.getAttribute('data-sheet');
          // Labelled for the state a click switches to; aria-pressed is true in the web view
          viewBtn.setAttribute('aria-pressed', view === 'web' ? 'true' : 'false');
          viewBtn.querySelector('.toggle-label').textContent = view === 'web' ? 'Page view' : 'Web view';
          sheetBtn.querySelector('.toggle-label').textContent = sheet === 'a4' ? 'US Letter' : 'A4';
          pdf.setAttribute('href', pdf.getAttribute('data-' + sheet + '-href'));
          pdf.setAttribute('download', pdf.getAttribute('data-' + sheet + '-file'));
          pdf.querySelector('.repo-path').textContent = pdf.getAttribute('data-' + sheet + '-label');
        }
        viewBtn.addEventListener('click', function () {
          var next = doc.getAttribute('data-view') === 'web' ? 'pages' : 'web';
          doc.setAttribute('data-view', next);
          remember('papyrus-view', next);
          sync();
        });
        sheetBtn.addEventListener('click', function () {
          var next = doc.getAttribute('data-sheet') === 'a4' ? 'letter' : 'a4';
          doc.setAttribute('data-sheet', next);
          remember('papyrus-sheet', next);
          sync();
        });
        sync();
        viewBtn.hidden = false;
        sheetBtn.hidden = false;
      })();
    </script>
  </div>
</Layout>

<style>
  .doc {
    box-sizing: border-box;
    width: min(100%, 760px);
    margin-inline: auto;
    padding: 32px 24px 96px;
  }

  .crumbs {
    display: flex;
    gap: 10px;
    margin-bottom: 56px;
    color: var(--faint);
    font-size: 14px;
    line-height: 1.45;
  }

  .crumbs a {
    text-decoration: none;
    color: var(--muted);
  }

  .crumbs a:is(:hover, :focus-visible) {
    color: var(--ink);
  }

  h1 {
    margin: 0 0 28px;
    font-family: var(--sans);
    font-size: clamp(30px, 6vw, 44px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .repo-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: -8px 0 32px;
  }

  /* The links and toggles under the H1: one family of small tinted buttons */
  article .repo {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    max-width: 100%;
    margin: 0;
    padding: 8px 14px;
    border: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
    border-radius: 4px;
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.4;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  article .repo:is(:hover, :focus-visible) {
    border-color: color-mix(in srgb, var(--ink) 40%, transparent);
    background: color-mix(in srgb, var(--ink) 10%, transparent);
  }

  article .repo:focus-visible {
    outline: 1px solid color-mix(in srgb, var(--ink) 70%, transparent);
    outline-offset: 3px;
  }

  article .repo[hidden] {
    display: none;
  }

  /* The format means nothing in the web view */
  .doc[data-view='web'] .sheet-toggle {
    display: none;
  }

  /* One icon per state of the view toggle: the page icon while in the web view, the web icon in pages */
  .view-toggle .icon-pages,
  .doc[data-view='web'] .view-toggle .icon-web {
    display: none;
  }

  .doc[data-view='web'] .view-toggle .icon-pages {
    display: block;
  }

  .repo svg {
    flex: none;
  }

  .repo-path {
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  @media (prefers-reduced-motion: reduce) {
    article .repo {
      transition: none;
    }
  }

  h2 {
    margin: 56px 0 16px;
    padding-top: 14px;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    font-family: var(--sans);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  p,
  li {
    color: var(--copy);
    font-size: 15px;
    line-height: 1.7;
  }

  p {
    margin: 0 0 16px;
  }

  ol,
  ul {
    margin: 0 0 16px;
    padding-left: 22px;
  }

  li {
    margin-bottom: 10px;
    padding-left: 4px;
  }

  li::marker {
    color: var(--muted);
  }

  strong {
    color: var(--ink);
    font-weight: 600;
  }

  code {
    padding: 1px 5px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--ink) 9%, transparent);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.92em;
    overflow-wrap: anywhere;
  }

  pre {
    margin: 0 0 16px;
    padding: 16px 18px;
    overflow-x: auto;
    border-radius: 6px;
    background: color-mix(in srgb, var(--ink) 7%, transparent);
    font-size: 14px;
    line-height: 1.6;
  }

  pre code {
    padding: 0;
    background: none;
    overflow-wrap: normal;
  }

  article a {
    color: var(--ink);
    text-underline-offset: 3px;
  }

  .note {
    margin-top: 48px;
    color: var(--muted);
    font-size: 14px;
  }

  /* Web view: the sheets drop out (display: contents, see PapyrusLeaf) and the content is one
     column as before the pages. A flex column lets the sheet specimens sit under the buttons,
     where they were, though their page comes after the intro in the markup. */
  .doc[data-view='web'] .leaf-set {
    display: flex;
    flex-direction: column;
  }

  /* Flex items do not collapse margins: the gap before an h2 is the old 56px less the 16px above */
  .doc[data-view='web'] h2 {
    margin-top: 40px;
  }

